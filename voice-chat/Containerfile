# LingoCoach image. The revOct23 spec shows port 8080; this checkout listens on 8066.
# Digest of python:3.12-slim-bookworm pulled in this environment.
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8066

# No apt-get here: many VPS Podman builds cannot resolve deb.debian.org
# ("Temporary failure resolving…"). English IPA uses phonemizer when espeak-ng
# is present on the host, otherwise the built-in grapheme fallback in
# app/phonetics/english.py.

WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY tests ./tests

# useradd needs passwd from the base image (no apt). UID matches the prior image.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser
USER 10001

EXPOSE 8066
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8066/health')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8066"]
