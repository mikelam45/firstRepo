# MacBook / local development. Copy to .env.development.
# scripts/dev.sh does that for you on first run.
APP_ENV=development
PORT=8099
DATA_DIR=data
# Leave unset in development. Notes are open on localhost.
PORTAL_API_TOKEN=
# OpenRouter is read from /Users/mikelam/firstRepo/openrouter_key/.env_RAG_portal
# when OPENROUTER_API_KEY is unset. Do not copy that file into this repo.
