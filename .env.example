# ==========================================
# THUNDERBIRD / EMAIL STORAGE CONFIGURATION
# ==========================================
# Read-only path to Thunderbird Mail directory containing mbox files.
# macOS: /Users/<user>/Library/Thunderbird/Profiles/<id>/Mail/Local Folders
# Linux: ~/.thunderbird/<id>/Mail/Local Folders
THUNDERBIRD_MAIL_PATH="/Users/your_username/Library/Thunderbird/Profiles/xxxxxx.default-release/Mail/Local Folders"

# mbox file name inside THUNDERBIRD_MAIL_PATH (e.g. INBOX, Applications)
TARGET_MAIL_FOLDER="INBOX"

# ==========================================
# LOCAL NETWORK LLM (OPENAI-COMPATIBLE)
# ==========================================
LLM_BASE_URL="http://192.168.1.100:1234/v1"
LLM_MODEL_NAME="llama-3-8b-instruct"
LLM_API_KEY="lm-studio"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ==========================================
# APPLICATION & PIPELINE SETTINGS
# ==========================================
BATCH_SIZE=10
OUTPUT_DIR="./output/candidate_reviews"
ROLE_CONFIG_PATH="./config/role_requirements.yaml"
PROMPT_VERSION="scorecard-v1"
DEBUG=true
