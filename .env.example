# ==========================================
# LOCAL PODMAN / DOCKER — HTTP on port 3036
# ==========================================
# cp .env.example .env
# podman compose up --build   OR bare-metal:
#   python3 -m candidate_eval.cli serve --port 3036
#
# Open: http://127.0.0.1:3036

HOST=0.0.0.0
PORT=3036

MAIL_HOST_PATH=./fixtures/mbox
OUTPUT_HOST_PATH=./output/candidate_reviews

THUNDERBIRD_MAIL_PATH="/data/mail"
TARGET_MAIL_FOLDER="Applications"
OUTPUT_DIR="/data/output"
ROLE_CONFIG_PATH="/app/config/role_requirements.yaml"

# Host LLM (Podman alias; use host.docker.internal for Docker Desktop)
LLM_BASE_URL="http://host.containers.internal:1234/v1"
LLM_MODEL_NAME="llama-3-8b-instruct"
LLM_API_KEY="lm-studio"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

BATCH_SIZE=10
PROMPT_VERSION="scorecard-v1"
DEBUG=true

# Bare-metal overrides (when not using compose mounts):
# THUNDERBIRD_MAIL_PATH="./fixtures/mbox"
# OUTPUT_DIR="./output/candidate_reviews"
# ROLE_CONFIG_PATH="./config/role_requirements.yaml"
# LLM_BASE_URL="http://127.0.0.1:1234/v1"
