# ==========================================
# LOCAL PODMAN / DOCKER — HTTP on port 3036
# ==========================================
# cp .env.example .env
# Place TLS cert + token under ./SSLcert/ (see SSLcert/README.md)
# python3 -m candidate_eval.cli serve --port 3036
# Open: http://127.0.0.1:3036

HOST=0.0.0.0
PORT=3036

MAIL_HOST_PATH=./fixtures/mbox
OUTPUT_HOST_PATH=./output/candidate_reviews

# Thunderbird mailbox URI (preferred) or filesystem mail directory
THUNDERBIRD_MAIL_PATH="mailbox://mikelam@systex.com.hk/Inbox/SE_2026"
TARGET_MAIL_FOLDER="Inbox/SE_2026"
# Filesystem alternative for fixtures/local mbox:
# THUNDERBIRD_MAIL_PATH="./fixtures/mbox"
# TARGET_MAIL_FOLDER="Applications"

OUTPUT_DIR="./output/candidate_reviews"
ROLE_CONFIG_PATH="./config/role_requirements.yaml"

# ==========================================
# Red Hat AI / Qwen (TLS + token file)
# ==========================================
# Mac / bare-metal: repo-relative paths (resolved against project root, not cwd).
# Place files at: <repo>/SSLcert/qwen-tls.crt and <repo>/SSLcert/token_qwen3_8.txt
# Podman/Docker: compose.yml overrides these to /app/SSLcert/... (bind-mount).
CERT_FILE="./SSLcert/qwen-tls.crt"
TOKEN_FILE="./SSLcert/token_qwen3_8.txt"
API_URL="https://redhataiqwen38-27b-int4-rhoai-test.apps.demo.rhoai.demo/v1/chat/completions"
MODEL_NAME="Qwen38-27b-int4"

# Pod / container DNS (compose.yml extra_hosts — --add-host inside the pod)
RHOAI_LLM_IP=192.168.147.135
RHOAI_LLM_HOST=redhataiqwen38-27b-int4-rhoai-test.apps.demo.rhoai.demo
# Bare-metal host OS: sudo bash scripts/setup_hosts.sh

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Short timeout for UI/CLI connectivity probes (page load never waits on LLM)
LLM_SMOKE_TIMEOUT_SECONDS=8
LLM_PROBE_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=3

BATCH_SIZE=10
PROMPT_VERSION="scorecard-v1"
DEBUG=true
