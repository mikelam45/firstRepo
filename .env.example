# ==========================================
# MacBook local only — http://127.0.0.1:3036
# ==========================================
# cp .env.example .env
# Put your OpenRouter key in .env (never commit .env)
# Run: bash scripts/run_local_mac.sh

HOST=127.0.0.1
PORT=3036

# Privacy review needs a filesystem mbox (not a bare mailbox:// URI):
THUNDERBIRD_MAIL_PATH="./fixtures/mbox"
TARGET_MAIL_FOLDER="Applications"

OUTPUT_DIR="./output/candidate_reviews"
ROLE_CONFIG_PATH="./config/role_requirements.yaml"

# Privacy: sensitive contact fields stay on this Mac in SQLite.
# Only redacted analysis text is eligible for LLM egress.
LOCAL_DB_PATH="./data/candidate_eval.sqlite"
# Set false for offline heuristic scoring (no network LLM call).
REVIEW_USE_LLM=true
# When mailbox:// has no local mbox file, JD match may use fixtures/mbox/Applications
JD_MATCH_USE_FIXTURE=true

# OpenRouter — https://openrouter.ai/keys
# CERT_FILE / TOKEN_FILE are skipped (API key + system CA only).
# Set ALLOW_LEGACY_TLS=true only for private RHOAI-style hosts.
ALLOW_LEGACY_TLS=false
OPENROUTER_API_KEY="sk-or-v1-REPLACE_ME"
LLM_API_KEY="sk-or-v1-REPLACE_ME"
API_URL="https://openrouter.ai/api/v1/chat/completions"
LLM_BASE_URL="https://openrouter.ai/api/v1"
MODEL_NAME="qwen/qwen3-32b"
OPENROUTER_HTTP_REFERER="http://127.0.0.1:3036"
OPENROUTER_APP_TITLE="Candidate Evaluation"

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_PROBE_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=3

BATCH_SIZE=10
PROMPT_VERSION="scorecard-v1"
DEBUG=true
